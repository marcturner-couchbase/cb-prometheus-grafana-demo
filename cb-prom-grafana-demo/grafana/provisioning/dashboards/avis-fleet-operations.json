      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(kv_cmd_duration_seconds_bucket{opcode=\"GET\"}[1m])) by (le)) * 1000",
