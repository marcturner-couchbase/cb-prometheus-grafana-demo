            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "legendFormat": "p95"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(kv_cmd_duration_seconds_bucket{opcode=\"GET\"}[1m])) by (le)) * 1000",
          "refId": "C",
