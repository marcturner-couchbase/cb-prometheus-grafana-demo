      "type": "text",
      "title": "",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 3
      },
      "options": {
        "mode": "html",
        "content": "\n<div style=\"display:flex;align-items:center;background:linear-gradient(90deg,#B10000 0%,#7A0000 100%);\n            padding:14px 20px;border-radius:6px;color:#fff;font-family:'Inter','Helvetica Neue',Arial,sans-serif;\">\n  <div style=\"flex:1;\">\n    <div style=\"font-size:22px;font-weight:700;letter-spacing:0.5px;\">AVIS FLEET OPERATIONS</div>\n    <div style=\"font-size:13px;opacity:0.9;margin-top:2px;\">Real-time vehicle availability, checkout/return, and booking traffic on Couchbase &mdash; bucket: avis-fleet</div>\n  </div>\n</div>\n"
      }
