{
  "id": null,
  "uid": "avis-fleet-ops",
  "title": "Avis Fleet Operations",
  "description": "Curated operational view of the avis-fleet bucket: availability lookups, checkout/return + booking writes, customer-facing latency, and capacity headroom.",
  "tags": [
    "couchbase",
    "avis",
    "demo"
